# =============================================================================
# Nex Gestão Vendas — environment template
# Copy to .env.local and fill values. NEVER commit real secrets.
# =============================================================================

# --- Public (browser-safe) ----------------------------------------------------
# REQUIRED for authenticated app runtime.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL display defaults (non-secret).
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
NEXT_PUBLIC_APP_CURRENCY=BRL

# OPTIONAL public sales page — WhatsApp contact for subscription plans (Sprint 4a).
# Must be https://wa.me/<number> or https://api.whatsapp.com/... — leave unset to hide CTAs.
# NEXT_PUBLIC_ASSINATURAS_WHATSAPP_URL=https://wa.me/5511999999999

# LOCAL/DEMO ONLY. Never enable in production.
# NEXT_PUBLIC_PDV_FIXTURES=1

# --- Server-only: application -------------------------------------------------
# REQUIRED in production (fail-closed boot + CSRF Origin allowlisting).
# APP_ORIGIN=https://pdv.example.com

# Set to 1 only when a trusted reverse proxy sanitizes X-Forwarded-For / X-Real-IP.
# TRUST_PROXY=1

# Production process must run with NODE_ENV=production (set by `pnpm start` / Docker).

# Server-only Supabase administration key. Keep empty unless a server-side
# provisioning script or worker explicitly requires it.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Server-only: fiscal provider --------------------------------------------
# Keep empty until a homologated provider is configured.
# Without all required values the adapter returns not_configured and never
# simulates success.
FISCAL_PROVIDER=
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_API_KEY=
FISCAL_PROVIDER_TIMEOUT_MS=15000

# Shared secret for /api/fiscal/outbox/process (min 32 random chars).
FISCAL_WORKER_SECRET=

# --- Server-only: payment provider -------------------------------------------
# Keep empty until a real provider is wired. Unconfigured methods stay
# not_configured and never fake capture/success.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_TIMEOUT_MS=15000

# Stripe card (testmode only). Never prefix with NEXT_PUBLIC_.
# Without both secrets + a successful health probe, card stays not_configured.
# CARD_CHECKOUT_ENABLED stays unset/false until card smoke passes.
# STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_placeholder
# STRIPE_TIMEOUT_MS=15000
# CARD_CHECKOUT_ENABLED=false

# Stripe PIX sibling rail (testmode). Same secrets. Fail-closed until smoke.
# Do not set PIX_CHECKOUT_ENABLED=true here; hold is the default.
# PIX_CHECKOUT_ENABLED=false

# Mercado Pago Orders rail (PIX via /v1/orders). Fail-closed until Pagamento smoke.
# Never commit real secrets. Keep MERCADOPAGO_CHECKOUT_ENABLED=false in deploy until GO.
# MERCADOPAGO_ACCESS_TOKEN=APP_USR_placeholder
# MP_ACCESS_TOKEN=APP_USR_placeholder
# MERCADOPAGO_WEBHOOK_SECRET=placeholder
# MP_WEBHOOK_SECRET=placeholder
# MERCADOPAGO_TIMEOUT_MS=15000
# REQUIRED for Orders PIX create (/v1/orders). Not optional — without a valid payer email
# the order fails at create time.
# Placeholder buyer@testuser.com is rejected by Mercado Pago with invalid_users_involved
# (HTTP 402). Never use .local domains (invalid_payer_email).
# Sandbox: use the test-account email from GET /users/me. Production: use the customer's email.
# MERCADOPAGO_PAYER_EMAIL=
# MP_PAYER_EMAIL=
# MERCADOPAGO_CHECKOUT_ENABLED=false

# --- Seed-only (local scripts) -----------------------------------------------
# Required by `pnpm seed:auth`. Never commit values.
# SEED_ADMIN_PASSWORD=
# SEED_MANAGER_PASSWORD=
# SEED_CASHIER_PASSWORD=
