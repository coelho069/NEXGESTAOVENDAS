# Example reverse proxy for Nex Gestão Vendas.
# Terminate TLS here. Do not expose Node directly to the internet.

upstream nex_app {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 80;
  server_name pdv.example.com;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name pdv.example.com;

  # ssl_certificate     /etc/ssl/certs/pdv.example.com.fullchain.pem;
  # ssl_certificate_key /etc/ssl/private/pdv.example.com.key;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

  # Do not add Access-Control-Allow-Origin *; the app is cookie/same-origin.
  client_max_body_size 2m;

  location /health/ {
    proxy_pass http://nex_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    proxy_pass http://nex_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
